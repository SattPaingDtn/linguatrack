{
  "name": "linguatrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run content:check && npm run curriculum:v2:schemas:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:generate": "node scripts/generate-content.mjs",
    "content:check": "node scripts/generate-content.mjs --check",
    "curriculum:v2:schemas": "tsx scripts/curriculum/cli.ts schemas",
    "curriculum:v2:schemas:check": "tsx scripts/curriculum/cli.ts schemas --check",
    "curriculum:v2:bridge": "tsx scripts/curriculum/cli.ts bridge",
    "curriculum:v2:validate": "tsx scripts/curriculum/cli.ts validate",
    "curriculum:v2:compatibility": "tsx scripts/curriculum/cli.ts compatibility",
    "test:curriculum:v2": "vitest run tests/curriculum-v2",
    "curriculum:v2:author-prototype": "tsx scripts/curriculum/author-prototype.ts",
    "curriculum:v2:edit-pronouns": "tsx scripts/curriculum/edit-pronouns.ts",
    "test:preview": "vitest run tests/preview",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "curriculum:registry": "node --conditions=react-server --import tsx scripts/curriculum/registry.ts",
    "test:registry": "vitest run tests/registry",
    "test:learning:v2": "vitest run tests/learning-v2",
    "test:learning:d4": "vitest run tests/learning-d4",
    "staging:check": "node --conditions=react-server --import tsx scripts/learning/staging.ts check",
    "staging:dev": "node --conditions=react-server --import tsx scripts/learning/staging.ts dev",
    "platform:audit": "node --conditions=react-server --import tsx scripts/platform/audit.ts",
    "test:platform": "vitest run tests/platform",
    "curriculum:v2:author-chapter": "tsx scripts/curriculum/author-chapter.ts",
    "curriculum:v2:author-a1-batch": "tsx scripts/curriculum/author-a1-batch.ts",
    "curriculum:v2:author-manuscript": "tsx scripts/curriculum/author-a1-manuscript.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.3.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  }
}
