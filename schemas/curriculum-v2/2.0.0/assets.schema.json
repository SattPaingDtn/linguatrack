              },
              "type": {
                "const": "package",
                "type": "string"
              }
            },
            "required": ["type", "path"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "objectKey": {
                "maxLength": 500,
                "pattern": "^[a-zA-Z0-9_-]+(?:\\/[a-zA-Z0-9_-]+)*(?:\\.[a-zA-Z0-9_-]+)?$",
