          "type": "string"
        },
        "kind": {
          "enum": ["course", "chapter", "lesson", "block", "question"],
          "type": "string"
        },
        "pointer": {
          "maxLength": 1000,
          "pattern": "^(?:\\/(?:[^~\\/]|~[01])*)*$",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        }
      },
