# Copy to .env.local. Leave BOTH blank to use the clearly labelled preview mode.
# Supabase Dashboard -> Project Settings -> API: Project URL and publishable key.
# The legacy anon key also works here. Never put a service_role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# D3 read-only combined history; leave false on existing/hosted environments.
# Enable only after the additive D3 migration is reviewed and installed in an isolated target.
# This flag does not enable v2 lesson delivery, submissions, publication or activation.
LINGUATRACK_V2_HISTORY_ENABLED=false

# D4 MCQ writer defaults off. Isolated staging uses .env.staging.example and staging:dev.
# Setting this flag alone cannot enable v2 writes in the existing app.
LINGUATRACK_V2_MCQ_ENABLED=false
