# HISTORICAL D4 TEMPLATE — superseded by the one-hosted-project product decision.
# Do not create another hosted project or use this template. See docs/platform-milestone-1.md.
# Prior design (retained for review only):
# The launcher checks this target differs from the project in the existing .env.local.
LINGUATRACK_RUNTIME_ENV=staging
LINGUATRACK_STAGING_PROJECT_REF=
LINGUATRACK_PROTECTED_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LINGUATRACK_V2_HISTORY_ENABLED=false
LINGUATRACK_V2_MCQ_ENABLED=false
# Assigned custom login role ONLY, never postgres/service_role/secret API key.
# Direct: postgresql://linguatrack_staging_app:<encoded-password>@db.<staging-ref>.supabase.co:5432/postgres
# Session pooler: use the Dashboard Connect host and username linguatrack_staging_app.<staging-ref>, port 5432.
LINGUATRACK_STAGING_WRITER_DATABASE_URL=
# Optional PEM CA from the staging Connect settings; use literal \n escapes on one line.
LINGUATRACK_STAGING_DATABASE_CA=
